  object qParameters: TFDQueryPlus
    AfterOpen = qParametersAfterOpen
    Connection = ConnectionSumms
    SQL.Strings = (
      
        'SELECT AutoCreateConstruction, AutoDeleteConstruction, BatchSize' +
        ', Company,'
