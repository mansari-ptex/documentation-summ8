  object qCountFullSyntheticParts: TFDQueryPlus
    Connection = ConnectionSumms
    SQL.Strings = (
      'SELECT COUNT(P.Code) as Total'
      'FROM Parts P, Material M'
      'WHERE (M.Code = P.Material) AND'
      '      ((M.Type = '#39'R'#39') OR (M.Type = '#39'S'#39')) AND'
      '   '#9'  (SLMAllowance = False)')
    Left = 354
    Top = 429
    object qCountFullSyntheticPartsTotal: TIntegerField
      FieldName = 'Total'
    end
  end
  object qCountLegacySyntheticParts: TFDQueryPlus
    Connection = ConnectionSumms
    SQL.Strings = (
      'SELECT COUNT(P.Code) as Total'
      'FROM Parts P, Material M'
      'WHERE (M.Code = P.Material) AND'
      '      ((M.Type = '#39'R'#39') OR (M.Type = '#39'S'#39')) AND'
      '   '#9'  (SLMAllowance = True)')
    Left = 476
    Top = 444
    object qCountLegacySyntheticPartsTotal: TIntegerField
      FieldName = 'Total'
    end
  end
