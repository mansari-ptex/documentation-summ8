  object adsLocalConnectionSumms: TAdsConnection
    AliasName = 'Summs7'
    AdsServerTypes = [stADS_REMOTE]
    LoginPrompt = False
    BeforeConnect = adsLocalConnectionSummsBeforeConnect
    Left = 486
    Top = 42
  end
  object qLayplans: TAdsQuery
    DatabaseName = 'adsLocalConnectionSumms'
    AfterOpen = qLayplansAfterOpen
    OnCalcFields = qLayplansCalcFields
    AdsTableOptions.AdsFreshRecordCount = True
    SQL.Strings = (
      'DECLARE @MyAllSizes INTEGER;'
      'DECLARE @MyPatternRes INTEGER;'
      'DECLARE @MyRollLengthFt DOUBLE;'
      ''
      'DECLARE MyCur CURSOR AS'
      
        '  SELECT P.Code, P.Material, P.SizeScale, P.SizeRange, SR.ShoeSi' +
        'ze, SSS.Seq, PWK.Knife,'
      
        '         PWK.SizeAdjustment, PWK.SizeRelationship, M.Units, U.Su' +
        'bUnitDesc, U.SubUnitAbbreviation,'
      
        '         ROUND(IIF(M.Type = '#39'R'#39', @MyRollLengthFt, (M.Length * U.' +
        'ToFeet / U.SubUnitsPerUnit)) * 12000 / @MyPatternRes, 0) as Leng' +
        'th,'
      
        '         ROUND((M.Width * U.ToFeet / U.SubUnitsPerUnit) * 12000 ' +
        '/ @MyPatternRes, 0) as Width,'
      
        '         M.Units, M.CutGap, IIF(M.CutType = '#39'R'#39', M.Code, NULL) a' +
        's RestrictiveMaterialCode,'
      
        '         IIF(M.Type = '#39'R'#39', @MyRollLengthFt * (U.SubUnitsPerUnit ' +
        '/ U.ToFeet), M.Length) as RealLength,'
      '         M.Width as RealWidth'
      
        '  FROM Parts P, PtWidKnf PWK, KnifeSets KS, Material M, MatUnits' +
        ' U, SizeRelationshipSizes SR,'
      '       SizeScaleSizes SSS'
      
        '  WHERE (P.Code = PWK.Part) AND (KS.Code = PWK.Knife) AND (KS.Ma' +
        'nualEntry = False) AND'
      
        '        (M.Code = P.Material) AND ((M.Type = '#39'R'#39') OR (M.Type = '#39 +
        'S'#39')) AND (U.Code = M.Units) AND'
      '        (SR.Scale = P.SizeScale) AND'
      '        (SR.Range = P.SizeRange) AND'
      '        (SR.Relationship = PWK.SizeRelationship) AND'
      
        '        ((((SR.ShoeSize = P.SampleSize) OR (SR.ShoeSize = P.Cost' +
        'edSize)) AND (@MyAllSizes = 1)) OR'
      '         ((SR.ShoeSize = P.SampleSize) AND (@MyAllSizes = 2)) OR'
      '         (@MyAllSizes = 0)) AND'
      '        (SSS.Scale = P.SizeScale) AND'
      '        (SSS.Size = SR.ShoeSize) AND'
      '        (P.SLMAllowance = False);'
      #9#9
      'DECLARE AdjCur CURSOR AS'
      '  SELECT SRSA.KnifeSize, SCS.Seq'
      
        '  FROM SizeRelationshipSizes SRS, SizeRelationshipSizes SRSA, Si' +
        'zeScaleSizes SCS'
      '  WHERE (SRS.Scale = MyCur.[SizeScale]) AND'
      '        (SRS.Range = MyCur.[SizeRange]) AND'
      '        (SRS.Relationship = MyCur.[SizeRelationship]) AND'
      '        (SRS.ShoeSize = MyCur.[ShoeSize]) AND'
      '        (SRSA.Scale = SRS.Scale) AND'
      '        (SRSA.Range = SRS.Range) AND'
      '        (SRSA.Relationship = SRS.Relationship) AND'
      '        (SRSA.Seq = SRS.Seq + MyCur.[SizeAdjustment]) AND'
      '        (SCS.Scale = MyCur.[SizeScale]) AND'
      '        (SCS.Size = SRSA.KnifeSize); '
      #9#9
      'SELECT '
      '  CAST(:AllSizes as sql_integer) AllSizes,'
      '  CAST(:PatternRes as sql_integer) PatternRes,'
      '  CAST(:RollLengthFt as sql_double) RollLengthFt'
      'INTO #temp3'
      'FROM system.iota; '
      ''
      '@MyAllSizes = (SELECT AllSizes FROM #Temp3);'
      '@MyPatternRes = (SELECT PatternRes FROM #Temp3);'
      '@MyRollLengthFt = (SELECT RollLengthFt FROM #Temp3);'
      ''
      'DROP TABLE #temp3; '
      
        #9#9'                                                              ' +
        '               '
      '//Ensure Temporary tables don'#39't exist'
      'TRY'
      '  DROP TABLE #TEMP;'
      '  DROP TABLE #TEMP2;'
      'CATCH ALL'
      'END TRY;'
      ''
      
        'CREATE TABLE #Temp(Knife CHAR(20), SizeScale CHAR(20), AdjustedS' +
        'ize CHAR(10), Length INTEGER, Width INTEGER,'
      
        '                   CutGap INTEGER, RestrictiveMaterialCode CHAR(' +
        '20), SizeSeq DOUBLE, SubUnitDesc CHAR(30),'
      
        '         '#9#9'       SubUnitAbbreviation CHAR(4), Units CHAR(20), R' +
        'ealLength DOUBLE, RealWidth DOUBLE,'
      '                   LayplanDone LOGICAL);'
      ''
      
        'CREATE TABLE #Temp2(Knife CHAR(20), SizeScale CHAR(20), Adjusted' +
        'Size CHAR(10), Length INTEGER, Width INTEGER,'
      
        '                    CutGap INTEGER, RestrictiveMaterialCode CHAR' +
        '(20), SizeSeq DOUBLE, SubUnitDesc CHAR(30),'
      
        '         '#9#9'        SubUnitAbbreviation CHAR(4), Units CHAR(20), ' +
        'RealLength DOUBLE, RealWidth DOUBLE);'
      ''
      
        'CREATE UNIQUE INDEX "PRIMARY" ON #Temp(Knife, SizeScale, Adjuste' +
        'dSize, Length, Width, CutGap, RestrictiveMaterialCode);'
      ''
      
        'INSERT INTO #Temp([Knife], [SizeScale], [AdjustedSize], [Length]' +
        ', [Width], [CutGap], [RestrictiveMaterialCode], [LayplanDone])'
      
        '  SELECT KnifeCode, KnifeSizeScale, KnifeSize, MaterialLength, M' +
        'aterialWidth, MaterialCutGap, MaterialCodeRestrictive, True'
      '  FROM LayplanSets;'
      ''
      'OPEN MyCur;'
      ''
      'WHILE FETCH MyCur DO'
      '  OPEN AdjCur;'
      '  WHILE FETCH AdjCur DO'
      '    TRY'
      
        '      INSERT INTO #Temp VALUES(MyCur.[Knife], MyCur.[SizeScale],' +
        ' AdjCur.[KnifeSize], MyCur.[Length], '#9#9#9' '
      
        '   '#9#9#9'                   MyCur.[Width], MyCur.[CutGap], MyCur.[R' +
        'estrictiveMaterialCode],'
      
        #9'  '#9#9#9#9#9#9'   AdjCur.[Seq], MyCur.[SubUnitDesc], MyCur.[SubUnitAbb' +
        'reviation], MyCur.[Units],'
      
        '                               MyCur.[RealLength], MyCur.[RealWi' +
        'dth], False);'
      '    CATCH ALL'
      '    END TRY;'#9#9#9#9#9#9#9'   '
      '  END WHILE; '
      '  CLOSE AdjCur;'#9#9
      'END WHILE;'
      ''
      'INSERT INTO #TEMP2'
      
        'SELECT Knife, SizeScale, AdjustedSize, Length, Width, CutGap, Re' +
        'strictiveMaterialCode, SizeSeq, SubUnitDesc,'
      '       SubUnitAbbreviation, Units, RealLength, RealWidth'
      'FROM #Temp'
      'WHERE LayplanDone = False;'
      ''
      
        'SELECT Knife, SizeScale, AdjustedSize, Length, Width, CutGap, Re' +
        'strictiveMaterialCode, SizeSeq, SubUnitDesc,'
      '       SubUnitAbbreviation, Units, RealLength, RealWidth'
      'FROM #TEMP2'
      'ORDER BY Knife, SizeScale, SizeSeq;'
      '')
    AdsConnection = adsLocalConnectionSumms
    Left = 520
    Top = 42
    ParamData = <
      item
        DataType = ftInteger
        Name = 'AllSizes'
        ParamType = ptInput
      end
      item
        DataType = ftUnknown
        Name = 'PatternRes'
        ParamType = ptUnknown
      end
      item
        DataType = ftUnknown
        Name = 'RollLengthFt'
        ParamType = ptUnknown
      end>
