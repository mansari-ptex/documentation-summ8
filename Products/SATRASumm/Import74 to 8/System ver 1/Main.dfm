  object qStructure: TFDQuery
    Connection = adsSumms
    SQL.Strings = (
      'TRY'
      '  INSERT INTO MatUnits'
      '  VALUES ('#39'YD'#39', '#39'Yards'#39', '#39'yd'#39', 3, '#39'Inches'#39', '#39'ins'#39', 36);'
      'CATCH ALL'
      'END TRY;'
      ''
      '//Add New PressTypes'
      'ALTER TABLE Parts'
      '  ADD COLUMN PressTypeLeather Char(1)'
      '    DEFAULT '#39'S'#39
      '  ADD COLUMN PressTypeSynthetic Char(1)'
      '    DEFAULT '#39'P'#39';'
      #9
      'UPDATE Parts'
      '  SET PressTypeLeather = '#39'S'#39','
      '      PressTypeSynthetic = '#39'P'#39'; '
      #9'  '
      'DROP INDEX Parts.PressType;'
      '  '
      'ALTER TABLE Parts'
      '  DROP COLUMN PressType'
      '  ALTER COLUMN PressTypeLeather PressTypeLeather Char(1)'
      '    CONSTRAINT NOT NULL  '
      '  ALTER COLUMN PressTypeSynthetic PressTypeSynthetic Char(1)'
      '    CONSTRAINT NOT NULL;'
      ''
      'DROP index MatTypes.PressType;'
      '  '
      'ALTER TABLE MatTypes'
      '  DROP COLUMN PressType;'
      '  '
      ' ALTER TABLE Params'
      '  ADD COLUMN PressTypeLeather Char(1)'
      '    DEFAULT '#39'S'#39
      '  ADD COLUMN PressTypeSynthetic Char(1)'
      '    DEFAULT '#39'P'#39';'
      #9
      'UPDATE Params'
      '  SET PressTypeLeather = '#39'S'#39','
      '      PressTypeSynthetic = '#39'P'#39'; '
      #9'  '
      'ALTER TABLE Params'
      '  ALTER COLUMN PressTypeLeather PressTypeLeather Char(1)'
      '    CONSTRAINT NOT NULL  '
      '  ALTER COLUMN PressTypeSynthetic PressTypeSynthetic Char(1)'
      '    CONSTRAINT NOT NULL;'
      '//End of...Add New PressTypes'
      ''
      'ALTER TABLE Params'
      '  ADD COLUMN WebAddress1 char(100)'
      '     CONSTRAINT NOT NULL'
      '  ADD COLUMN WebAddress2 char(100)'
      '     CONSTRAINT NOT NULL'
      '  ADD COLUMN WebAddress3 char(100)'
      '     CONSTRAINT NOT NULL'
      '  ADD COLUMN WebAddress4 char(100)'
      '     CONSTRAINT NOT NULL'
      '  ADD COLUMN WebAddress5 char(100)'
      '     CONSTRAINT NOT NULL'
      '  DROP CuttingLevelBase;'
      ''
      'GRANT Select( [WebAddress1] ) ON [Params]  TO  [Grp Default];'
      'GRANT Select( [WebAddress2] ) ON [Params]  TO  [Grp Default];'
      'GRANT Select( [WebAddress3] ) ON [Params]  TO  [Grp Default];'
      'GRANT Select( [WebAddress4] ) ON [Params]  TO  [Grp Default];'
      'GRANT Select( [WebAddress5] ) ON [Params]  TO  [Grp Default];'
      ''
      'UPDATE Params'
      '  SET WebAddress1 = '#39'http://www.satra.co.uk/'#39','
      
        '      WebAddress2 = '#39'http://www.satra.co.uk/production_efficienc' +
        'y_systems/'#39','
      '      WebAddress3 = '#39'http://www.satra.co.uk/satrasumm/'#39','
      '      WebAddress4 = '#39'http://www.satra.co.uk/visionstitch/'#39','
      '      WebAddress5 = '#39'http://www.satra.co.uk/timeline/'#39';'
      ''
      'DROP TABLE Elements;'
      ''
      'CREATE TABLE Elements ( '
      '      Code Char( 10 ),'
      '      Description Char( 60 ),'
      '      CuttingCategory Char( 1 )) IN DATABASE;'
      ''
      'EXECUTE PROCEDURE sp_CreateIndex90( '
      '   '#39'Elements'#39','
      '   '#39'Elements.adi'#39','
      '   '#39'PRIMARY'#39','
      '   '#39'Code'#39','
      '   '#39#39','
      '   2051,'
      '   512,'
      '   '#39#39' ); '
      ''
      'EXECUTE PROCEDURE sp_ModifyTableProperty( '#39'Elements'#39', '
      '   '#39'Table_Auto_Create'#39', '
      '   '#39'False'#39', '#39'APPEND_FAIL'#39', '#39'Elementsfail'#39');'
      ''
      'EXECUTE PROCEDURE sp_ModifyTableProperty( '#39'Elements'#39', '
      '   '#39'Table_Primary_Key'#39', '
      '   '#39'PRIMARY'#39', '#39'APPEND_FAIL'#39', '#39'Elementsfail'#39');'
      ''
      'EXECUTE PROCEDURE sp_ModifyTableProperty( '#39'Elements'#39', '
      '   '#39'Table_Permission_Level'#39', '
      '   '#39'2'#39', '#39'APPEND_FAIL'#39', '#39'Elementsfail'#39');'
      ''
      'EXECUTE PROCEDURE sp_ModifyTableProperty( '#39'Elements'#39', '
      '   '#39'Triggers_Disabled'#39', '
