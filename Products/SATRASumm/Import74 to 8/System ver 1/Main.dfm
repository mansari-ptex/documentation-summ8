      'DROP INDEX LayplanSetKnives."PRIMARY";'
      ''
      'EXECUTE PROCEDURE sp_CreateIndex90('
      '   '#39'LayplanSetKnives'#39','
      '   '#39'LayplanSetKnives.adi'#39','
      '   '#39'KEEPUNIQUE'#39','
      '//   '#39'PRIMARY'#39', see below comment'
      
        '   '#39'KnifeCode+KnifeSizeScale+KnifeSize;MaterialLength;MaterialWi' +
        'dth;MaterialCutGap;MaterialCodeRestrictive;KnifeNo;RealNotExpand' +
        'ed;W2;Seq'#39','
      '   '#39#39','
      '   2051,'
      '   512,'
      '   '#39#39' );'
      ''
      
        '// Above index was called PRIMARY and set as the primary index. ' +
        'This causes issues. '
      
        '// Actually the index was only there to preserve uniqueness and ' +
        'did not NEED to be '
      
        '// the primary key. It was renamed and the below setting removed' +
        '.'
      '/* '
      'EXECUTE PROCEDURE sp_ModifyTableProperty( '#39'LayplanSetKnives'#39','
      '   '#39'Table_Primary_Key'#39','
      '   '#39'PRIMARY'#39', '#39'APPEND_FAIL'#39', '#39'LayplanSetKnivesfail'#39');'
      '*/'
      '  '
