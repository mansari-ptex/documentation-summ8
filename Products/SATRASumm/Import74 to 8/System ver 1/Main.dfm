      'EXECUTE PROCEDURE sp_Reindex( '#39'LayplanPlans.adt'#39', 1024 );'
      'EXECUTE PROCEDURE sp_Reindex( '#39'LayplanSetKnives.adt'#39', 1024 );'
      'EXECUTE PROCEDURE sp_Reindex( '#39'LayplanSets.adt'#39', 1024 );'
      ''
      ''
      '')
    Left = 178
    Top = 41
  end
