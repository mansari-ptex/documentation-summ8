  object qStructure2: TFDQuery
    Connection = adsSumms
    SQL.Strings = (
      'CREATE FUNCTION FormatFieldValue'
      '   ('
      '   TableName CHAR ( 50 ),'
      '      FieldName CHAR ( 50 ),'
      '      FieldValue CHAR ( 50 )'
      '   )'
      '   RETURNS CHAR ( 60 )'
      'BEGIN'
      'DECLARE @FieldValue varchar(50);'
      'DECLARE @FieldType integer;'
      'DECLARE @FormattedFieldValue varchar(60);'
      ''
      'DECLARE MyCur CURSOR AS'
      
        '  SELECT Field_Type FROM System.Columns WHERE Name = FieldName A' +
        'ND Parent = TableName;'
      ''
      '@FieldValue = RTRIM(FieldValue);'
      ''
      'OPEN MyCur;'
      'FETCH MyCur;'
      '@FieldType = MyCur.[Field_Type];'
      'CLOSE MyCur;'
      ''
      'IF @FieldType = 1 THEN'
      '  IF @FieldValue = '#39'0'#39' THEN'
      '    @FormattedFieldValue = '#39'False'#39';'
      '  ELSE'
      '    @FormattedFieldValue = '#39'True'#39';'
      '  END;'
      
        'ELSEIF @FieldType IN (2, 3, 6, 9, 10, 11, 12, 13, 14, 15, 17, 18' +
        ', 19, 21, 22, 24) THEN'
      '  @FormattedFieldValue = @FieldValue;'
      'ELSEIF @FieldType IN (4, 5, 8, 20, 23, 26, 27, 28) THEN'
      '  @FormattedFieldValue = '#39#39#39#39' + @FieldValue + '#39#39#39#39';'
      'ELSE'
      '  @FormattedFieldValue = '#39'NULL'#39';'
      'END;'
      ''
      'RETURN @FormattedFieldValue;'
      ''
      ''
      ''
      'END;')
    Left = 146
    Top = 17
  end
  object qStructure3: TFDQuery
    Connection = adsSumms
    SQL.Strings = (
      'CREATE PROCEDURE FindRecNo'
      '   ( '
      '      LockingTable CHAR ( 50 ),'
      '      LockingField CHAR ( 50 ),'
      '      LockingField2 CHAR ( 50 ),'
      '      LockingValue CHAR ( 50 ),'
      '      LockingValue2 CHAR ( 50 ),'
      '      RecNo Integer OUTPUT'
      '   ) '
      'BEGIN '
      'DECLARE @LockingTable varchar(50);'
      'DECLARE @LockingField varchar(50);'
      'DECLARE @LockingField2 varchar(50);'
      'DECLARE @LockingValue varchar(50);'
      'DECLARE @LockingValue2 varchar(50);'
      ''
      'DECLARE @FormattedFieldValue varchar(60);'
      'DECLARE @FormattedFieldValue2 varchar(60);'
      ''
      'DECLARE @BASE64 CHAR(64);'
      'DECLARE @SQL varchar(2000);'
      ''
      'SET @LockingTable = (SELECT LockingTable FROM __input);'
      'SET @LockingField = (SELECT LockingField FROM __input);'
      'SET @LockingField2 = (SELECT LockingField2 FROM __input);'
      'SET @LockingValue = (SELECT LockingValue FROM __input);'
      'SET @LockingValue2 = (SELECT LockingValue2 FROM __input);'
      ''
      
        'SET @Base64 = '#39'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvw' +
        'xyz0123456789+/'#39';'
      ''
      
        '@FormattedFieldValue = FormatFieldValue(@LockingTable, @LockingF' +
        'ield, @LockingValue);'
      'IF @LockingField2 <> '#39#39' THEN'
      
        '  @FormattedFieldValue2 = FormatFieldValue(@LockingTable, @Locki' +
        'ngField2, @LockingValue2);'
      'END;'
      ''
      
        'SET @SQL = '#39'INSERT INTO __Output VALUES ((SELECT TOP 1 ((Positio' +
        'n(substring(ROWID, 13, 1) IN '#39#39#39' + @Base64 + '#39#39#39') - 1) * 1073741' +
        '824) + '#39' +'
      
        '           '#39'   ((Position(substring(ROWID, 14, 1) IN '#39#39#39' + @Base' +
        '64 + '#39#39#39') - 1) * 16777216) + '#39' +'
      
        '           '#39'   ((Position(substring(ROWID, 15, 1) IN '#39#39#39' + @Base' +
        '64 + '#39#39#39') - 1) * 262144) + '#39' +'
      
        '           '#39'   ((Position(substring(ROWID, 16, 1) IN '#39#39#39' + @Base' +
        '64 + '#39#39#39') - 1) * 4096) + '#39' +'
      
        '           '#39'   ((Position(substring(ROWID, 17, 1) IN '#39#39#39' + @Base' +
        '64 + '#39#39#39') - 1) * 64) + '#39' +'
      
        '           '#39'    (Position(substring(ROWID, 18, 1) IN '#39#39#39' + @Base' +
        '64 + '#39#39#39') - 1) '#39' + '
      '           '#39'FROM '#39' + @LockingTable + '#39' '#39' +'
      
        '           '#39'WHERE '#39' + @LockingField + '#39' = '#39' + @FormattedFieldVal' +
        'ue; '
      'IF @LockingField2 <> '#39#39' THEN'
      
        '  SET @SQL = @SQL + '#39' AND '#39' + @LockingField2 + '#39' = '#39' + @Formatte' +
        'dFieldValue2; '
      'END;'
      'SET @SQL = @SQL + '#39'))'#39';'
      ''
      'EXECUTE IMMEDIATE @SQL; '
      ''
      ''
      ''
      ''
      ''
      ''
      'END;'
      ''
      'EXECUTE PROCEDURE sp_ModifyProcedureProperty( '#39'FindRecNo'#39', '
      '   '#39'COMMENT'#39', '
      '   '#39#39');'
      '')
    Left = 162
    Top = 25
  end
  object qStructure4: TFDQuery
    Connection = adsSumms
    SQL.Strings = (
      'CREATE PROCEDURE LocksLockedBy'
      '   ( '
      '      LockingTable CHAR ( 50 ),'
      '      LockingField CHAR ( 50 ),'
      '      LockingField2 CHAR ( 50 ),'
      '      LockingOption CHAR ( 50 ),'
      '      LockingOption2 CHAR ( 50 ),'
      '      LockingUser CHAR ( 260 ) OUTPUT'
      '   ) '
      'BEGIN '
      'DECLARE @aLockInfo CURSOR;'
      'DECLARE @aRecNo CURSOR;'
      ''
      'DECLARE @LockingTable CHAR(50);'
      'DECLARE @LockingField CHAR(50);'
      'DECLARE @LockingField2 CHAR(50);'
      'DECLARE @LockingOption CHAR(50);'
      'DECLARE @LockingOption2 CHAR(50);'
      'DECLARE @RecNo integer;'
      ''
      'DECLARE @NAME VARCHAR(260);'
      'DECLARE @DBPATH VARCHAR(260);'
      'DECLARE @TBNAME VARCHAR(260);'
      'DECLARE @UNC VARCHAR(520);'
      'DECLARE @i INTEGER;'
      ''
      '@LockingTable = (SELECT LockingTable FROM __Input);'
      '@LockingField = (SELECT LockingField FROM __Input);'
      '@LockingField2 = (SELECT LockingField2 FROM __Input);'
      '@LockingOption = (SELECT LockingOption FROM __Input);'
      '@LockingOption2 = (SELECT LockingOption2 FROM __Input);'
      ''
      
        'OPEN @aRecNo AS EXECUTE PROCEDURE FindRecNo(@LockingTable, @Lock' +
        'ingField, @LockingField2, @LockingOption, @LockingOption2);'
      'FETCH @aRecNo;'
      '@RecNo = @aRecNo.[RecNo];'
      'CLOSE @aRecNo; '
      ''
      '@DBPATH = DATABASE();'
      
        '@TBNAME = (SELECT Table_Relative_Path FROM system.tables WHERE N' +
        'AME = @LockingTable);'
      ''
      '@DBPATH = TRIM(@DBPATH);'
      '@TBNAME = TRIM(@TBNAME);'
      ''
      '@i = LENGTH(@DBPATH) - 1;'
      'WHILE @i >= 1 DO'
      '  IF SUBSTRING(@DBPATH, @i, 1) = '#39'\'#39' THEN'
      '    @DBPATH = SUBSTRING(@DBPATH, 1, @i);'
      '    @i = -1;'
      '  END IF;'
      '  @i = @i - 1;'
      'END WHILE;'
      ''
      '@UNC = @DBPATH + @TBNAME;'
      
        '//The following line causes a problem with the query in the upgr' +
        'ade program                 <<<*'
      
        '//code. The line in the UPGRADE PROGRAM must have DOUBLE SLASHES' +
        ' wherever a                    *'
      
        '//SINGLE SLASH is required in the finished PROCEDURE that the up' +
        'grade program               <<<* IMPORTANT'
      
        '//creates. This is due to the slash being an escape character. W' +
        'hat we are                     *'
      
        '//trying to replace is a string of SLASH DOT SLASH with a string' +
        ' of SLASH.                  <<<*'
      '@UNC = REPLACE(@UNC, '#39'\\.\\'#39', '#39'\\'#39');'
      ''
      
        'OPEN @aLockInfo AS EXECUTE PROCEDURE sp_mgGetLockOwner(@UNC, @Re' +
        'cNo);'
      'WHILE FETCH @aLockInfo DO'
      '  INSERT INTO __output VALUES (@aLockInfo.DictionaryUser);'
      'END WHILE;'
      'CLOSE @aLockInfo;'
      ''
      ''
      ''
      ''
      ''
      ''
      ''
      'END;'
      ''
      'EXECUTE PROCEDURE sp_ModifyProcedureProperty( '#39'LocksLockedBy'#39', '
      '   '#39'COMMENT'#39', '
      '   '#39#39');')
    Left = 170
    Top = 33
  end
