  object qTimeLineElements: TFDQueryPlus
    Connection = ConnectionTimeLine
    SQL.Strings = (
      
        'SELECT E.Code, E.Description, E.Machining, False as PerBatch, ET' +
        '.Time'
      'FROM Elements E, ElementTimes ET'
      'WHERE E.Cutting = True AND'
      '      ET.Code = E.Code'
      #9#9#9#9#9' '
      'Order By 1, 1')
    Left = 136
    Top = 141
    object qTimeLineElementsCode: TStringField
      FieldName = 'Code'
      Size = 5
    end
    object qTimeLineElementsDescription: TStringField
      FieldName = 'Description'
      Size = 40
    end
    object qTimeLineElementsMachining: TBooleanField
      FieldName = 'Machining'
    end
    object qTimeLineElementsPerBatch: TBooleanField
      FieldName = 'PerBatch'
    end
    object qTimeLineElementsTime: TFloatField
      FieldName = 'Time'
      DisplayFormat = '0.0000'
      EditFormat = '0.0000'
    end
    object qTimeLineElementsTimeDisplay: TFloatField
      FieldKind = fkCalculated
      FieldName = 'TimeDisplay'
      DisplayFormat = '0.0000'
      EditFormat = '0.0000'
      Calculated = True
    end
    object qTimeLineElementsPerBatchDisplay: TStringField
      FieldKind = fkCalculated
      FieldName = 'PerBatchDisplay'
      Size = 3
      Calculated = True
    end
    object qTimeLineElementsSelected: TBooleanField
      FieldKind = fkCalculated
      FieldName = 'Selected'
      Calculated = True
    end
  end
